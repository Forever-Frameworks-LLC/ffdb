{
  "name": "@ffdb/example-field-notes",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "setup": "node --env-file-if-exists=.env.local ./scripts/setup.mjs",
    "smoke:node": "node --env-file-if-exists=.env.local ./scripts/node-smoke.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@ffdb/client": "workspace:*",
    "@ffdb/react": "workspace:*",
    "@ffdb/sync-client": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@ffdb/cli": "workspace:*",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
