# Browser-safe values. The project ID is an identifier, not a secret.
VITE_FFDB_PROJECT_ID=your-project-id

# The Vite development server proxies FFDB HTTP calls so the hosted API does
# not need to trust a temporary localhost browser origin. Object storage still
# needs to allow http://127.0.0.1:5180 in its provider CORS configuration.
FFDB_PROXY_TARGET=https://your-ffdb-host.example.com

# Trusted Node-only setup and smoke-test values. Never rename the developer key
# with a VITE_ or EXPO_PUBLIC_ prefix.
FFDB_API_URL=https://your-ffdb-host.example.com
FFDB_DEVELOPER_KEY=replace-with-a-scoped-project-key

# Used by `pnpm smoke:node` only.
FFDB_TEST_EMAIL=field-notes@example.com
FFDB_TEST_PASSWORD=replace-with-a-test-user-password

# Optional direct browser API origin. Leave unset to use the Vite proxy above.
# VITE_FFDB_API_URL=https://your-ffdb-host.example.com
