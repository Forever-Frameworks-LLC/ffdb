FFDB_ENVIRONMENT=development
FFDB_HTTP_BIND=0.0.0.0:8080
FFDB_PUBLIC_BASE_URL=http://localhost:8080
FFDB_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FFDB_DATABASE_URL=postgres://ffdb:ffdb-local-password@localhost:5432/ffdb
FFDB_POSTGRES_MAX_CONNECTIONS=20
FFDB_RATE_LIMIT_PRE_AUTH_CAPACITY=120
FFDB_RATE_LIMIT_PRE_AUTH_REFILL_PER_SECOND=2
FFDB_RATE_LIMIT_EXECUTION_CAPACITY=2000
FFDB_RATE_LIMIT_EXECUTION_REFILL_PER_SECOND=200
FFDB_RATE_LIMIT_IDLE_TTL_SECONDS=3600
FFDB_RATE_LIMIT_MAX_ENTRIES=1000000
FFDB_NODE_ID=01965555-0000-7000-8000-000000000001
FFDB_NODE_NAME=ffdb-local-01
FFDB_DATABASE_ROOT=./data/projects
FFDB_BACKUP_ROOT=./data/backups
FFDB_METRICS_ROOT=./data/metrics
FFDB_DATABASE_WORKER=target/debug/ffdb-database-worker
FFDB_WORKER_MAX_PROCESSES=8
FFDB_WORKER_QUEUE_CAPACITY=32
FFDB_TRUSTED_PROXY_CIDRS=172.16.0.0/12
# 32 zero bytes encoded as base64; replace outside disposable local development.
FFDB_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Independent 32-byte backup AEAD root key; rotate through tested backup rewrap procedures.
FFDB_BACKUP_MASTER_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
FFDB_CURSOR_HMAC_KEY=local-only-cursor-key-change-before-production
FFDB_BOOTSTRAP_TOKEN=local-bootstrap-token-change-before-production
FFDB_S3_ENDPOINT=http://localhost:9000
# Production rejects private-address S3 endpoints by default. Set this only when
# FFDB_S3_ENDPOINT is an exact operator-controlled private HTTPS service hostname;
# it never relaxes validation of FFDB_S3_PUBLIC_ENDPOINT.
FFDB_S3_ALLOW_PRIVATE_NETWORK=false
# Browser-facing URL used only when constructing signed operations. It can differ
# from the server's private FFDB_S3_ENDPOINT in container or split-horizon networks.
FFDB_S3_PUBLIC_ENDPOINT=http://localhost:9000
FFDB_S3_REGION=us-east-1
FFDB_S3_BUCKET=ffdb
FFDB_S3_ACCESS_KEY_ID=ffdb-local
FFDB_S3_SECRET_ACCESS_KEY=ffdb-local-secret-change-me
# SMTP is accepted only in development/test and is pinned to the configured local
# host. Production configuration rejects SMTP and requires Resend.
FFDB_EMAIL_TRANSPORT=smtp
FFDB_SMTP_HOST=localhost
FFDB_SMTP_PORT=1025
# For production use FFDB_EMAIL_TRANSPORT=resend and set a real secret:
# FFDB_RESEND_API_KEY=re_replace_with_secret
FFDB_EMAIL_FROM=FFDB <noreply@localhost.test>
# Optional platform billing. Configure every Stripe value together; secret and
# webhook keys are server-only and must never use VITE_*/EXPO_PUBLIC_* names.
# Current integration uses multi-item usage subscriptions, Billing Meters,
# Checkout Sessions, Customer Portal, reconciliation summaries, and signed
# webhooks with Stripe API 2026-02-25.clover. PAYG and Pro need separate Prices
# per meter because their included quantities differ. Configure Stripe meter
# aggregation as sum; storage is reported in decimal kilobyte-hours.
# FFDB_STRIPE_SECRET_KEY=sk_test_replace_me
# FFDB_STRIPE_WEBHOOK_SECRET=whsec_replace_me
# FFDB_STRIPE_PRO_BASE_PRICE_ID=price_replace_pro_base
# FFDB_STRIPE_READS_EVENT_NAME=ffdb_reads
# FFDB_STRIPE_READS_METER_ID=mtr_replace_reads
# FFDB_STRIPE_PAYG_READS_PRICE_ID=price_replace_payg_reads
# FFDB_STRIPE_PRO_READS_PRICE_ID=price_replace_pro_reads
# FFDB_STRIPE_WRITES_EVENT_NAME=ffdb_writes
# FFDB_STRIPE_WRITES_METER_ID=mtr_replace_writes
# FFDB_STRIPE_PAYG_WRITES_PRICE_ID=price_replace_payg_writes
# FFDB_STRIPE_PRO_WRITES_PRICE_ID=price_replace_pro_writes
# FFDB_STRIPE_STORAGE_EVENT_NAME=ffdb_storage_kilobyte_hours
# FFDB_STRIPE_STORAGE_METER_ID=mtr_replace_storage
# FFDB_STRIPE_PAYG_STORAGE_PRICE_ID=price_replace_payg_storage
# FFDB_STRIPE_PRO_STORAGE_PRICE_ID=price_replace_pro_storage
# FFDB_STRIPE_MAU_EVENT_NAME=ffdb_monthly_active_users
# FFDB_STRIPE_MAU_METER_ID=mtr_replace_mau
# FFDB_STRIPE_PAYG_MAU_PRICE_ID=price_replace_payg_mau
# FFDB_STRIPE_PRO_MAU_PRICE_ID=price_replace_pro_mau
# FFDB_STRIPE_PRO_BILLING_UNIT=organization
# FFDB_BILLING_SUCCESS_URL=http://localhost:5173/app/billing/success
# FFDB_BILLING_CANCEL_URL=http://localhost:5173/app/billing/cancel
# FFDB_BILLING_PORTAL_RETURN_URL=http://localhost:5173/app/billing
# Optional, dedicated credentials for onboarding the FFDB instance billing account.
# These are intentionally separate from customer-project commerce credentials.
# FFDB_INSTANCE_STRIPE_CONNECT_SECRET_KEY=sk_test_replace_instance_connect_platform
# FFDB_INSTANCE_STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_instance_connect_endpoint
# Optional platform credentials for per-project Stripe Connect direct charges.
# Omit both to support BYO project keys only.
# FFDB_COMMERCE_STRIPE_CONNECT_SECRET_KEY=sk_test_replace_connect_platform
# FFDB_COMMERCE_STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_connect_endpoint
# Contributor Vite apps use the directly published Axum development port below.
# Packaged releases instead use the compiled nginx gateway on port 5173 and do
# not publish Axum port 8080 to the host.
# The portal stores the developer session in sessionStorage. Never bake project
# API keys or any other credential into VITE_* variables.
VITE_FFDB_API_URL=http://localhost:8080
