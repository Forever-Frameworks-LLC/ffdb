{
  "name": "@ffdb/client",
  "version": "0.3.3",
  "description": "Universal TypeScript client for the self-hosted FFDB Rust API",
  "keywords": ["ffdb", "sqlite", "database", "offline-first", "typescript"],
  "homepage": "https://ffdb.forever-frameworks.com/docs/client",
  "license": "Apache-2.0",
  "author": "Forever Frameworks <admin@forever-frameworks.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forever-Frameworks-LLC/ffdb.git",
    "directory": "packages/client"
  },
  "bugs": { "url": "https://github.com/Forever-Frameworks-LLC/ffdb/issues" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "!dist/**/*.test.*"],
  "engines": { "node": ">=24" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
