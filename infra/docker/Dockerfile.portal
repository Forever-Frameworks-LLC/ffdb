FROM node:24.5.0-alpine AS builder

RUN corepack enable && corepack prepare pnpm@11.6.0 --activate
WORKDIR /build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/landing ./apps/landing
COPY apps/docs ./apps/docs
COPY apps/portal ./apps/portal
RUN pnpm install --frozen-lockfile \
    && pnpm --filter @ffdb/client build \
    && pnpm --filter @ffdb/landing build:gateway \
    && pnpm --filter @ffdb/docs build:gateway \
    && pnpm --filter @ffdb/portal build:gateway

FROM nginx:1.29.0-alpine
RUN rm -f /etc/nginx/conf.d/default.conf
COPY infra/docker/nginx.conf /etc/nginx/nginx.conf
COPY infra/docker/portal-nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --chmod=0755 infra/docker/gateway-entrypoint.sh /usr/local/bin/ffdb-gateway-entrypoint
COPY --from=builder /build/apps/landing/dist /usr/share/nginx/html
COPY --from=builder /build/apps/docs/dist /usr/share/nginx/html/docs
COPY --from=builder /build/apps/portal/dist /usr/share/nginx/html/app
ENV NGINX_ENVSUBST_FILTER="^FFDB_S3_PUBLIC_ORIGIN$" \
    NGINX_ENVSUBST_OUTPUT_DIR=/tmp/nginx-conf \
    FFDB_S3_PUBLIC_ORIGIN="http://localhost:9000 http://127.0.0.1:9000"
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=6 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
ENTRYPOINT ["/usr/local/bin/ffdb-gateway-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
