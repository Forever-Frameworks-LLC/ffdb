# syntax=docker/dockerfile:1

# Release images consume binaries already compiled on architecture-native GitHub
# runners. This keeps the container packaging step deterministic and avoids
# recompiling the Rust workspace under QEMU.
FROM debian:bookworm-slim AS runtime

ARG TARGETARCH
ARG VERSION

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl sqlite3 tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 ffdb \
    && useradd --system --uid 10001 --gid ffdb --home-dir /var/lib/ffdb ffdb \
    && install -d -o ffdb -g ffdb \
         /var/lib/ffdb/projects \
         /var/lib/ffdb/backups \
         /var/lib/ffdb/metrics \
         /var/lib/ffdb/sync

COPY --chmod=0755 dist/image-input/runtime/${TARGETARCH}/ffdb-api /usr/local/bin/ffdb-api
COPY --chmod=0755 dist/image-input/runtime/${TARGETARCH}/ffdb-database-worker /usr/local/bin/ffdb-database-worker
COPY --chmod=0755 dist/image-input/runtime/${TARGETARCH}/ffdb-sync-worker /usr/local/bin/ffdb-sync-worker

LABEL org.opencontainers.image.version=$VERSION

USER ffdb:ffdb
WORKDIR /var/lib/ffdb
ENV FFDB_DATABASE_ROOT=/var/lib/ffdb/projects \
    FFDB_BACKUP_ROOT=/var/lib/ffdb/backups \
    FFDB_METRICS_ROOT=/var/lib/ffdb/metrics \
    FFDB_DATABASE_WORKER=/usr/local/bin/ffdb-database-worker \
    FFDB_SYNC_STATE_DIR=/var/lib/ffdb/sync

EXPOSE 8080
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/ffdb-api"]
