# Copy to .env.production, replace every replace-me value, and chmod 0600.
# This file is read by Docker Compose for interpolation; do not commit the copy.
FFDB_IMAGE_TAG=local
FFDB_GATEWAY_PORT=5173

# The public FFDB origin terminates TLS in the operator-managed reverse proxy.
FFDB_PUBLIC_BASE_URL=https://ffdb.example.com
FFDB_CORS_ALLOWED_ORIGINS=https://ffdb.example.com
FFDB_DOCKER_SUBNET=172.30.0.0/24
FFDB_TRUSTED_PROXY_CIDRS=172.30.0.0/24

# Use a least-privilege TLS-enabled PostgreSQL role. URL-encode reserved password characters.
FFDB_DATABASE_URL=postgres://ffdb:replace-me@postgres.example.com:5432/ffdb?sslmode=require
FFDB_POSTGRES_MIN_CONNECTIONS=2
FFDB_POSTGRES_MAX_CONNECTIONS=20
FFDB_POSTGRES_ACQUIRE_TIMEOUT_MS=5000
FFDB_POSTGRES_IDLE_TIMEOUT_SECONDS=600
FFDB_POSTGRES_MAX_LIFETIME_SECONDS=1800
FFDB_RATE_LIMIT_PRE_AUTH_CAPACITY=120
FFDB_RATE_LIMIT_PRE_AUTH_REFILL_PER_SECOND=2
FFDB_RATE_LIMIT_EXECUTION_CAPACITY=2000
FFDB_RATE_LIMIT_EXECUTION_REFILL_PER_SECOND=200
FFDB_RATE_LIMIT_IDLE_TTL_SECONDS=3600
FFDB_RATE_LIMIT_MAX_ENTRIES=1000000
FFDB_NODE_ID=019fc39c-ddbd-7d12-9849-e4ee35310132
FFDB_NODE_NAME=ffdb-production-01
FFDB_WORKER_MAX_PROCESSES=8
FFDB_WORKER_QUEUE_CAPACITY=32
FFDB_API_CPUS=2.0
FFDB_API_MEMORY_LIMIT=2g
FFDB_API_PIDS_LIMIT=512

# Generate the first two with `openssl rand -base64 32` and the latter two with
# `openssl rand -hex 32`. Keep all four stable and backed up in a secret manager.
FFDB_MASTER_KEY=replace-me-with-32-bytes-of-base64
FFDB_BACKUP_MASTER_KEY=replace-me-with-an-independent-32-byte-base64-key
FFDB_CURSOR_HMAC_KEY=replace-me-with-at-least-32-random-characters
FFDB_BOOTSTRAP_TOKEN=replace-me-with-at-least-32-random-characters

# Both endpoints must be HTTPS. The internal endpoint may use an operator-owned
# private hostname only when FFDB_S3_ALLOW_PRIVATE_NETWORK=true.
FFDB_S3_ENDPOINT=https://s3.example.com
FFDB_S3_ALLOW_PRIVATE_NETWORK=false
FFDB_S3_PUBLIC_ENDPOINT=https://s3.example.com
FFDB_S3_PUBLIC_ORIGIN=https://s3.example.com
FFDB_S3_REGION=us-east-1
FFDB_S3_BUCKET=ffdb
FFDB_S3_ACCESS_KEY_ID=replace-me
FFDB_S3_SECRET_ACCESS_KEY=replace-me

FFDB_RESEND_API_KEY=re_replace_me
FFDB_EMAIL_FROM=FFDB <noreply@example.com>
FFDB_RUST_LOG=ffdb=info,tower_http=info

# Optional platform billing. Uncomment and configure every value together.
# FFDB_STRIPE_SECRET_KEY=sk_live_replace_me
# FFDB_STRIPE_WEBHOOK_SECRET=whsec_replace_me
# FFDB_STRIPE_PRO_BASE_PRICE_ID=price_replace_pro_base
# FFDB_STRIPE_READS_EVENT_NAME=ffdb_reads
# FFDB_STRIPE_READS_METER_ID=mtr_replace_reads
# FFDB_STRIPE_PAYG_READS_PRICE_ID=price_replace_payg_reads
# FFDB_STRIPE_PRO_READS_PRICE_ID=price_replace_pro_reads
# FFDB_STRIPE_WRITES_EVENT_NAME=ffdb_writes
# FFDB_STRIPE_WRITES_METER_ID=mtr_replace_writes
# FFDB_STRIPE_PAYG_WRITES_PRICE_ID=price_replace_payg_writes
# FFDB_STRIPE_PRO_WRITES_PRICE_ID=price_replace_pro_writes
# FFDB_STRIPE_STORAGE_EVENT_NAME=ffdb_storage_kilobyte_hours
# FFDB_STRIPE_STORAGE_METER_ID=mtr_replace_storage
# FFDB_STRIPE_PAYG_STORAGE_PRICE_ID=price_replace_payg_storage
# FFDB_STRIPE_PRO_STORAGE_PRICE_ID=price_replace_pro_storage
# FFDB_STRIPE_MAU_EVENT_NAME=ffdb_monthly_active_users
# FFDB_STRIPE_MAU_METER_ID=mtr_replace_mau
# FFDB_STRIPE_PAYG_MAU_PRICE_ID=price_replace_payg_mau
# FFDB_STRIPE_PRO_MAU_PRICE_ID=price_replace_pro_mau
# FFDB_STRIPE_PRO_BILLING_UNIT=organization
# FFDB_BILLING_SUCCESS_URL=https://portal.invalid/app/billing/success
# FFDB_BILLING_CANCEL_URL=https://portal.invalid/app/billing/cancel
# FFDB_BILLING_PORTAL_RETURN_URL=https://portal.invalid/app/billing
# Dedicated optional instance-billing Connect credentials.
# FFDB_INSTANCE_STRIPE_CONNECT_SECRET_KEY=sk_live_replace_instance_connect
# FFDB_INSTANCE_STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_instance_connect
# Separate optional customer-project commerce Connect credentials.
# FFDB_COMMERCE_STRIPE_CONNECT_SECRET_KEY=sk_live_replace_commerce_connect
# FFDB_COMMERCE_STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_commerce_connect
FFDB_SYNC_MAINTENANCE_INTERVAL_SECONDS=60
FFDB_SYNC_STALE_TEMPORARY_SECONDS=3600
FFDB_SYNC_CPUS=0.5
FFDB_SYNC_MEMORY_LIMIT=256m
FFDB_SYNC_PIDS_LIMIT=64
FFDB_GATEWAY_CPUS=0.5
FFDB_GATEWAY_MEMORY_LIMIT=256m
FFDB_GATEWAY_PIDS_LIMIT=64
