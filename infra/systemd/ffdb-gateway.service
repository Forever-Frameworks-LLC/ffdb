[Unit]
Description=FFDB static web and HTTPS reverse-proxy gateway
Wants=network-online.target
After=network-online.target ffdb-api.service

[Service]
Type=notify
User=ffdb
Group=ffdb
Environment=HOME=/var/lib/ffdb/caddy
ExecStartPre=/usr/bin/caddy validate --config /etc/ffdb/Caddyfile --adapter caddyfile
ExecStart=/usr/bin/caddy run --environ --config /etc/ffdb/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/ffdb/Caddyfile --adapter caddyfile --force
TimeoutStopSec=5s
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ReadOnlyPaths=/etc/ffdb/Caddyfile /var/www/ffdb
ReadWritePaths=/var/lib/ffdb/caddy
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
