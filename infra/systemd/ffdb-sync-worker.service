[Unit]
Description=FFDB durable sync-state maintenance worker
Wants=network-online.target
After=network-online.target ffdb-api.service

[Service]
Type=simple
User=ffdb
Group=ffdb
WorkingDirectory=/var/lib/ffdb
EnvironmentFile=/etc/ffdb/ffdb.env
ExecStart=/usr/local/bin/ffdb-sync-worker
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ffdb/sync
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
LimitNOFILE=8192
TasksMax=64

[Install]
WantedBy=multi-user.target
