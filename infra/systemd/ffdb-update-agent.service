[Unit]
Description=Process constrained FFDB host update requests
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
# Cosign's bundle verifier initializes its Sigstore trusted-root cache below
# $HOME. Keep /root hidden by ProtectHome and give only this updater service a
# dedicated writable cache home inside its existing ReadWritePaths boundary.
Environment=HOME=/var/cache/ffdb-updater
ExecStart=/usr/local/bin/ffdb-update process
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ffdb /etc/ffdb /etc/sysusers.d /etc/tmpfiles.d /var/lib/ffdb /var/cache/ffdb-updater /var/www /usr/local/bin /run/lock /etc/systemd/system
NoNewPrivileges=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
# RestrictSUIDSGID blocks openat2 entirely because seccomp cannot inspect the
# indirect mode argument. GNU tar uses openat2 for safe extraction, so the
# updater validates archive modes itself and extracts without restoring owner
# or unrestricted permissions instead.
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
AmbientCapabilities=
TimeoutStartSec=30min
UMask=0077
