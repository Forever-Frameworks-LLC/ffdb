#!/bin/sh
set -eu

# This executable is deliberately a constrained protocol, not a general-purpose
# privileged command runner. The public commands only create validated request
# files. A root-owned, path-activated systemd service performs the fixed actions.
OFFICIAL_REPOSITORY=Forever-Frameworks-LLC/ffdb
OFFICIAL_RELEASES=https://github.com/$OFFICIAL_REPOSITORY/releases
INSTALL_ROOT=/opt/ffdb
STATE_ROOT=/var/lib/ffdb
UPDATER_ROOT=$STATE_ROOT/updater
REQUEST_ROOT=$STATE_ROOT/update-requests
JOBS_ROOT=$UPDATER_ROOT/jobs
CACHE_ROOT=/var/cache/ffdb-updater
CURRENT_LINK=$INSTALL_ROOT/current
RELEASES_ROOT=$INSTALL_ROOT/releases
SETTINGS_FILE=$UPDATER_ROOT/settings.json
STATUS_FILE=$UPDATER_ROOT/status.json
AVAILABLE_FILE=$UPDATER_ROOT/available-release.json
LOCK_FILE=/run/lock/ffdb-update.lock
ENV_CONFIG=/etc/ffdb/ffdb.env
CADDY_CONFIG=/etc/ffdb/Caddyfile
SYSTEMCTL=systemctl
CURL=curl
COSIGN=cosign

# Tests may relocate state and provide deterministic command fakes. These
# overrides are ignored by installed systemd units and cannot alter production
# release identity or URLs.
if [ "${FFDB_UPDATER_TEST_MODE:-0}" = 1 ]; then
  test_root=${FFDB_UPDATER_TEST_ROOT:?}
  INSTALL_ROOT=$test_root/opt/ffdb
  STATE_ROOT=$test_root/var/lib/ffdb
  UPDATER_ROOT=$STATE_ROOT/updater
  REQUEST_ROOT=$STATE_ROOT/update-requests
  JOBS_ROOT=$UPDATER_ROOT/jobs
  CACHE_ROOT=$test_root/var/cache/ffdb-updater
  CURRENT_LINK=$INSTALL_ROOT/current
  RELEASES_ROOT=$INSTALL_ROOT/releases
  SETTINGS_FILE=$UPDATER_ROOT/settings.json
  STATUS_FILE=$UPDATER_ROOT/status.json
  AVAILABLE_FILE=$UPDATER_ROOT/available-release.json
  LOCK_FILE=$test_root/run/lock/ffdb-update.lock
  ENV_CONFIG=$test_root/etc/ffdb/ffdb.env
  CADDY_CONFIG=$test_root/etc/ffdb/Caddyfile
  SYSTEMCTL=${FFDB_UPDATER_SYSTEMCTL:-systemctl}
  CURL=${FFDB_UPDATER_CURL:-curl}
  COSIGN=${FFDB_UPDATER_COSIGN:-cosign}
  OFFICIAL_RELEASES=${FFDB_UPDATER_RELEASES_URL:-$OFFICIAL_RELEASES}
fi

say() { printf '%s\n' "ffdb-update: $*" >&2; }
fail() {
  code=$1
  retryable=$2
  shift 2
  if command -v jq >/dev/null 2>&1; then
    jq -cn --arg code "$code" --arg message "$*" --argjson retryable "$retryable" \
      '{code:$code,message:$message,retryable:$retryable}' >&2
  else
    printf '%s\n' "ffdb-update: error: $*" >&2
  fi
  exit 1
}
die() { fail invalid_request false "$*"; }
now() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }

usage() {
  cat <<'EOF'
Usage:
  ffdb-update inspect
  ffdb-update submit check
  ffdb-update submit install VERSION
  ffdb-update submit rollback VERSION
  ffdb-update submit configure --channel stable --automatic-checks BOOL \
    --check-interval-hours HOURS --automatic-apply BOOL \
    --maintenance-window disabled|HH:MM/DURATION_MINUTES
  ffdb-update job UUID

Internal root-only commands: initialize, process, auto-check
EOF
}

require_command() { command -v "$1" >/dev/null 2>&1 || die "$1 is required"; }
require_root() { [ "$(id -u)" -eq 0 ] || die "internal operation requires root"; }
valid_version() {
  printf '%s\n' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z][0-9A-Za-z.-]*)?$'
}
valid_uuid() {
  printf '%s\n' "$1" | grep -Eiq '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
}
valid_bool() { [ "$1" = true ] || [ "$1" = false ]; }
version_ge() { [ "$1" = "$2" ] || [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | sed -n '2p')" = "$1" ]; }
version_gt() { [ "$1" != "$2" ] && version_ge "$1" "$2"; }

atomic_json() {
  destination=$1
  shift
  temporary=$destination.tmp.$$
  "$@" > "$temporary"
  chmod 0640 "$temporary"
  chown root:ffdb "$temporary" 2>/dev/null || true
  mv "$temporary" "$destination"
}

default_settings() {
  jq -n '{channel:"stable",automatic_checks:true,check_interval_hours:24,automatic_apply:false,maintenance_window_start:null,maintenance_window_duration_minutes:60}'
}

initialize() {
  require_root
  require_command jq
  install -d -m 0755 "$INSTALL_ROOT" "$RELEASES_ROOT"
  install -d -m 0750 -o root -g ffdb "$UPDATER_ROOT"
  install -d -m 1770 -o root -g ffdb "$REQUEST_ROOT"
  install -d -m 1730 -o root -g ffdb "$JOBS_ROOT"
  install -d -m 0700 -o root -g root "$CACHE_ROOT" "$(dirname "$LOCK_FILE")"
  if [ ! -f "$SETTINGS_FILE" ]; then
    atomic_json "$SETTINGS_FILE" default_settings
  fi
  if [ ! -f "$STATUS_FILE" ]; then
    timestamp=$(now)
    atomic_json "$STATUS_FILE" jq -n --arg updated "$timestamp" \
      '{available_version:null,last_check_at:null,updated_at:$updated}'
  fi
}

read_settings() {
  if [ -f "$SETTINGS_FILE" ]; then
    jq -e 'select(.channel=="stable") | select(.automatic_checks|type=="boolean") | select(.automatic_apply|type=="boolean") | select(.check_interval_hours|type=="number")' "$SETTINGS_FILE"
  else
    default_settings
  fi
}

installed_version() {
  if [ -L "$CURRENT_LINK" ] && [ -f "$CURRENT_LINK/VERSION" ]; then
    sed -n '1p' "$CURRENT_LINK/VERSION"
  elif [ -f "$STATE_ROOT/installed-version" ]; then
    sed -n '1p' "$STATE_ROOT/installed-version"
  fi
}

job_json() {
  job_id=$1
  valid_uuid "$job_id" || fail invalid_job_id false "invalid job id"
  job_file=$JOBS_ROOT/$job_id.json
  [ -f "$job_file" ] || fail not_found false "job not found"
  jq -e . "$job_file"
}

active_job_json() {
  # Jobs are UUID-addressed so the directory never needs to be exposed to the
  # API user. Root's inspect command may enumerate; unprivileged inspection
  # returns null if directory listing is denied.
  active=null
  if [ -f "$UPDATER_ROOT/active-job" ]; then
    active_id=$(sed -n '1p' "$UPDATER_ROOT/active-job")
    if valid_uuid "$active_id" && [ -f "$JOBS_ROOT/$active_id.json" ]; then
      active=$(jq -c . "$JOBS_ROOT/$active_id.json")
    fi
  elif [ -r "$JOBS_ROOT" ]; then
    for candidate in "$JOBS_ROOT"/*.json; do
      [ -f "$candidate" ] || continue
      state=$(jq -r '.state // empty' "$candidate" 2>/dev/null || true)
      case "$state" in queued|running) active=$(jq -c . "$candidate"); break ;; esac
    done
  fi
  printf '%s\n' "$active"
}

compat_value() {
  key=$1
  file=$2
  awk -F= -v wanted="$key" '$1 == wanted {sub(/^[^=]*=/, ""); print; exit}' "$file"
}

rollback_compatible() {
  target=$1
  active=$2
  [ -f "$target/COMPATIBILITY" ] && [ -f "$active/COMPATIBILITY" ] || return 1
  target_schema=$(compat_value FFDB_NATIVE_STATE_SCHEMA "$target/COMPATIBILITY")
  active_schema=$(compat_value FFDB_NATIVE_STATE_SCHEMA "$active/COMPATIBILITY")
  minimum=$(compat_value FFDB_NATIVE_MINIMUM_ROLLBACK_VERSION "$active/COMPATIBILITY")
  [ -n "$target_schema" ] && [ "$target_schema" = "$active_schema" ] || return 1
  valid_version "$minimum" && version_ge "$(sed -n '1p' "$target/VERSION")" "$minimum"
}

releases_json() {
  active=
  [ -L "$CURRENT_LINK" ] && active=$(readlink -f "$CURRENT_LINK" 2>/dev/null || true)
  releases='[]'
  if [ -r "$RELEASES_ROOT" ]; then
    for release in "$RELEASES_ROOT"/*; do
      [ -d "$release" ] && [ -f "$release/VERSION" ] || continue
      version=$(sed -n '1p' "$release/VERSION")
      valid_version "$version" || continue
      release_path=$(readlink -f "$release" 2>/dev/null || printf '%s' "$release")
      is_active=false
      [ "$release_path" != "$active" ] || is_active=true
      compatible=false
      if [ -n "$active" ] && rollback_compatible "$release" "$active"; then compatible=true; fi
      verified=false
      [ ! -f "$release/.signature-verified" ] || verified=true
      state_schema=0
      minimum_rollback=null
      if [ -f "$release/COMPATIBILITY" ]; then
        schema_value=$(compat_value FFDB_NATIVE_STATE_SCHEMA "$release/COMPATIBILITY")
        minimum_value=$(compat_value FFDB_NATIVE_MINIMUM_ROLLBACK_VERSION "$release/COMPATIBILITY")
        printf '%s\n' "$schema_value" | grep -Eq '^[0-9]+$' && state_schema=$schema_value
        valid_version "$minimum_value" && minimum_rollback=$minimum_value
      fi
      signature_identity=null
      [ ! -f "$release/.signature-identity" ] || signature_identity=$(sed -n '1p' "$release/.signature-identity")
      release_url=$OFFICIAL_RELEASES/tag/v$version
      releases=$(printf '%s' "$releases" | jq \
        --arg version "$version" --argjson active "$is_active" \
        --argjson compatible "$compatible" --argjson verified "$verified" \
        --arg url "$release_url" --argjson schema "$state_schema" \
        --arg minimum "$minimum_rollback" --arg identity "$signature_identity" \
        '. + [{version:$version,active:$active,rollback_compatible:$compatible,
               signature_verified:$verified,release_url:$url,state_schema:$schema,
               minimum_rollback_version:(if $minimum=="null" then null else $minimum end),
               signature_identity:(if $identity=="null" then null else $identity end)}]')
    done
  fi
  cached_available=
  [ ! -f "$STATUS_FILE" ] || cached_available=$(jq -r '.available_version // empty' "$STATUS_FILE")
  if [ -n "$cached_available" ] && valid_version "$cached_available" \
    && ! printf '%s' "$releases" | jq -e --arg version "$cached_available" 'any(.[]; .version==$version)' >/dev/null \
    && [ -f "$AVAILABLE_FILE" ] \
    && [ "$(jq -r '.version // empty' "$AVAILABLE_FILE")" = "$cached_available" ] \
    && [ "$(jq -r '.signature_verified // false' "$AVAILABLE_FILE")" = true ]; then
    cached_schema=$(jq -r '.state_schema' "$AVAILABLE_FILE")
    cached_minimum=$(jq -r '.minimum_rollback_version' "$AVAILABLE_FILE")
    cached_identity=$(jq -r '.signature_identity' "$AVAILABLE_FILE")
    cached_url=$(jq -r '.release_url' "$AVAILABLE_FILE")
    releases=$(printf '%s' "$releases" | jq --arg version "$cached_available" \
      --argjson schema "$cached_schema" --arg minimum "$cached_minimum" \
      --arg identity "$cached_identity" --arg url "$cached_url" \
      '. + [{version:$version,active:false,rollback_compatible:false,state_schema:$schema,
             minimum_rollback_version:$minimum,signature_verified:true,
             signature_identity:$identity,release_url:$url}]')
  fi
  printf '%s\n' "$releases"
}

inspect() {
  require_command jq
  installed=$(installed_version || true)
  status='{"available_version":null,"last_check_at":null}'
  [ ! -f "$STATUS_FILE" ] || status=$(jq -c . "$STATUS_FILE")
  settings=$(read_settings)
  active=$(active_job_json)
  releases=$(releases_json)
  current_schema=0
  current_minimum=null
  signature_identity=null
  if [ -f "$CURRENT_LINK/COMPATIBILITY" ]; then
    schema_value=$(compat_value FFDB_NATIVE_STATE_SCHEMA "$CURRENT_LINK/COMPATIBILITY")
    minimum_value=$(compat_value FFDB_NATIVE_MINIMUM_ROLLBACK_VERSION "$CURRENT_LINK/COMPATIBILITY")
    printf '%s\n' "$schema_value" | grep -Eq '^[0-9]+$' && current_schema=$schema_value
    valid_version "$minimum_value" && current_minimum=$minimum_value
  fi
  [ ! -f "$CURRENT_LINK/.signature-identity" ] || signature_identity=$(sed -n '1p' "$CURRENT_LINK/.signature-identity")
  available=$(printf '%s' "$status" | jq -r '.available_version // empty')
  update_available=false
  if [ -n "${installed:-}" ] && [ -n "$available" ] && valid_version "$installed" \
    && valid_version "$available" && version_gt "$available" "$installed"; then
    update_available=true
  fi
  jq -n --arg installed "${installed:-}" --argjson status "$status" \
    --argjson active "$active" --argjson releases "$releases" \
    --argjson settings "$settings" --argjson state_schema "$current_schema" \
    --arg minimum "$current_minimum" --arg identity "$signature_identity" \
    --argjson update_available "$update_available" '
      ($status.available_version // null) as $available |
      {installed_version:(if $installed=="" then null else $installed end),
       available_version:$available,
       update_available:$update_available,
       last_check_at:($status.last_check_at // null),active_job:$active,releases:$releases,
       state_schema:$state_schema,
       minimum_rollback_version:(if $minimum=="null" then null else $minimum end),
       signature_identity:(if $identity=="null" then null else $identity end),
       capabilities:{check:true,install:true,rollback:true,automatic_checks:true,automatic_apply:true},
       settings:$settings}'
}

new_uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then
    sed -n '1p' /proc/sys/kernel/random/uuid
  elif command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  else
    die "kernel UUID generation is unavailable"
  fi
}

create_queued_job() {
  operation=$1
  requested=${2:-}
  id=$(new_uuid)
  queued=$(find "$REQUEST_ROOT" -mindepth 1 -maxdepth 1 -type f -name '*.json' -print | wc -l | tr -d ' ')
  [ "$queued" -lt 32 ] || fail busy true "updater queue already contains 32 requests"
  timestamp=$(now)
  request_file=$REQUEST_ROOT/$id.json
  job_file=$JOBS_ROOT/$id.json
  request_tmp=$REQUEST_ROOT/.$id.request.$$
  job_tmp=$JOBS_ROOT/.$id.job.$$
  umask 077
  jq -n --arg id "$id" --arg operation "$operation" --arg requested "$requested" \
    '{schema_version:1,job_id:$id,operation:$operation,requested_version:(if $requested=="" then null else $requested end)}' > "$request_tmp"
  jq -n --arg id "$id" --arg operation "$operation" --arg requested "$requested" --arg timestamp "$timestamp" \
    '{schema_version:1,job_id:$id,operation:$operation,requested_version:(if $requested=="" then null else $requested end),state:"queued",phase:"queued",installed_version:null,available_version:null,previous_version:null,backup_path:null,message:"Update request accepted",error_code:null,retryable:false,created_at:$timestamp,updated_at:$timestamp}' > "$job_tmp"
  chmod 0640 "$job_tmp"
  mv "$job_tmp" "$job_file"
  mv "$request_tmp" "$request_file"
  jq -e . "$job_file"
}

submit_configure() {
  channel=
  automatic_checks=
  interval=
  automatic_apply=
  window=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --channel) [ "$#" -ge 2 ] || die "--channel requires a value"; channel=$2; shift 2 ;;
      --automatic-checks) [ "$#" -ge 2 ] || die "--automatic-checks requires a value"; automatic_checks=$2; shift 2 ;;
      --check-interval-hours) [ "$#" -ge 2 ] || die "--check-interval-hours requires a value"; interval=$2; shift 2 ;;
      --automatic-apply) [ "$#" -ge 2 ] || die "--automatic-apply requires a value"; automatic_apply=$2; shift 2 ;;
      --maintenance-window) [ "$#" -ge 2 ] || die "--maintenance-window requires a value"; window=$2; shift 2 ;;
      *) die "unknown configure option: $1" ;;
    esac
  done
  [ "$channel" = stable ] || die "channel must be stable"
  valid_bool "$automatic_checks" || die "automatic checks must be true or false"
  valid_bool "$automatic_apply" || die "automatic apply must be true or false"
  printf '%s\n' "$interval" | grep -Eq '^[0-9]+$' || die "check interval must be an integer"
  [ "$interval" -ge 1 ] && [ "$interval" -le 168 ] || die "check interval must be 1..168 hours"
  if [ "$window" != disabled ]; then
    printf '%s\n' "$window" | grep -Eq '^([01][0-9]|2[0-3]):[0-5][0-9]/([1-9][0-9]{1,2}|[1-9])$' \
      || die "maintenance window must be disabled or HH:MM/DURATION_MINUTES"
    duration=${window#*/}
    [ "$duration" -ge 15 ] && [ "$duration" -le 1440 ] || die "maintenance duration must be 15..1440 minutes"
  fi
  [ "$automatic_apply" != true ] || [ "$window" != disabled ] \
    || die "automatic apply requires a maintenance window"
  requested=$(jq -cn --arg channel "$channel" --argjson checks "$automatic_checks" \
    --argjson interval "$interval" --argjson apply "$automatic_apply" --arg window "$window" \
    '{channel:$channel,automatic_checks:$checks,check_interval_hours:$interval,automatic_apply:$apply,maintenance_window:$window}' | base64 | tr -d '\n')
  create_queued_job configure "$requested"
}

submit() {
  require_command jq
  initialize_public=0
  [ -d "$REQUEST_ROOT" ] && [ -d "$JOBS_ROOT" ] \
    || fail not_installed false "updater is not initialized"
  operation=${1:-}
  [ -n "$operation" ] || die "submit requires an operation"
  shift
  case "$operation" in
    check) [ "$#" -eq 0 ] || die "check accepts no arguments"; create_queued_job check ;;
    install|rollback)
      [ "$#" -eq 1 ] || die "$operation requires one version"
      valid_version "$1" || die "invalid version"
      create_queued_job "$operation" "$1"
      ;;
    configure) submit_configure "$@" ;;
    *) die "operation must be check, install, rollback, or configure" ;;
  esac
}

job_patch() {
  id=$1
  state=$2
  phase=$3
  message=$4
  error_code=${5:-}
  retryable=${6:-false}
  installed=${7:-}
  available=${8:-}
  previous=${9:-}
  backup=${10:-}
  job_file=$JOBS_ROOT/$id.json
  timestamp=$(now)
  temporary=$job_file.tmp.$$
  jq --arg state "$state" --arg phase "$phase" --arg message "$message" \
    --arg error "$error_code" --argjson retryable "$retryable" \
    --arg installed "$installed" --arg available "$available" \
    --arg previous "$previous" --arg backup "$backup" --arg updated "$timestamp" '
      .state=$state | .phase=$phase | .message=$message | .retryable=$retryable |
      .error_code=(if $error=="" then null else $error end) |
      .installed_version=(if $installed=="" then .installed_version else $installed end) |
      .available_version=(if $available=="" then .available_version else $available end) |
      .previous_version=(if $previous=="" then .previous_version else $previous end) |
      .backup_path=(if $backup=="" then .backup_path else $backup end) |
      .updated_at=$updated' "$job_file" > "$temporary"
  chown root:ffdb "$temporary" 2>/dev/null || true
  chmod 0640 "$temporary"
  mv "$temporary" "$job_file"
}

secure_job_file() {
  candidate=$1
  [ -f "$candidate" ] && [ ! -L "$candidate" ] || return 1
  [ "$(stat -c '%h' "$candidate" 2>/dev/null || printf 0)" = 1 ] || return 1
  owner=$(stat -c '%U' "$candidate" 2>/dev/null || true)
  [ "$owner" = ffdb ] || [ "$owner" = root ]
}

secure_request_file() {
  candidate=$1
  [ -f "$candidate" ] && [ ! -L "$candidate" ] || return 1
  [ "$(stat -c '%h' "$candidate" 2>/dev/null || printf 0)" = 1 ] || return 1
  owner=$(stat -c '%U' "$candidate" 2>/dev/null || true)
  [ "$owner" = ffdb ] || [ "$owner" = root ]
}

download() {
  url=$1
  output=$2
  "$CURL" --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
    --connect-timeout 15 --max-time 300 "$url" -o "$output"
}

file_sha256() { sha256sum "$1" | awk '{print $1}'; }
verify_checksum() {
  checksums=$1
  path=$2
  name=$3
  expected=$(awk -v wanted="$name" '$2 == wanted {print $1; exit}' "$checksums")
  [ -n "$expected" ] || die "$name is absent from signed SHA256SUMS"
  [ "$(file_sha256 "$path")" = "$expected" ] || die "SHA-256 mismatch for $name"
}

host_arch() {
  case "$(uname -m)" in x86_64|amd64) printf amd64 ;; aarch64|arm64) printf arm64 ;; *) die "unsupported architecture" ;; esac
}

fetch_verified_release() {
  version=$1
  include_archive=$2
  valid_version "$version" || die "invalid release version"
  require_command "$CURL"
  require_command "$COSIGN"
  require_command sha256sum
  require_command jq
  tag=v$version
  base=$OFFICIAL_RELEASES/download/$tag
  destination=$CACHE_ROOT/$version
  staging=$CACHE_ROOT/.verify-$version-$$
  rm -rf "$staging"
  install -d -m 0700 "$staging"
  trap 'rm -rf "$staging"' EXIT HUP INT TERM
  download "$base/SHA256SUMS" "$staging/SHA256SUMS" || die "could not download signed checksums"
  download "$base/SHA256SUMS.sigstore.json" "$staging/SHA256SUMS.sigstore.json" \
    || die "could not download release signature bundle"
  identity=https://github.com/$OFFICIAL_REPOSITORY/.github/workflows/release.yml@refs/tags/$tag
  "$COSIGN" verify-blob "$staging/SHA256SUMS" \
    --bundle "$staging/SHA256SUMS.sigstore.json" \
    --certificate-identity "$identity" \
    --certificate-oidc-issuer https://token.actions.githubusercontent.com >/dev/null \
    || die "release signature verification failed"
  for asset in stable.txt release-manifest.json; do
    download "$base/$asset" "$staging/$asset" || die "could not download $asset"
    verify_checksum "$staging/SHA256SUMS" "$staging/$asset" "$asset"
  done
  [ "$(tr -d '\r\n' < "$staging/stable.txt")" = "$version" ] || die "stable metadata does not match release"
  arch=$(host_arch)
  manifest=$staging/release-manifest.json
  jq -e --arg version "$version" --arg tag "$tag" --arg repo "$OFFICIAL_REPOSITORY" \
    'select(.schema_version==2 and .version==$version and .release_tag==$tag and .github_repository==$repo) |
     select(.native_update.state_schema|type=="number") |
     select(.native_update.minimum_upgrade_version|type=="string") |
     select(.native_update.minimum_rollback_version|type=="string")' "$manifest" >/dev/null \
    || die "release manifest is unsupported or inconsistent"
  minimum_upgrade=$(jq -r '.native_update.minimum_upgrade_version' "$manifest")
  minimum_rollback=$(jq -r '.native_update.minimum_rollback_version' "$manifest")
  valid_version "$minimum_upgrade" && valid_version "$minimum_rollback" || die "release compatibility metadata is invalid"
  asset=$(jq -r --arg arch "$arch" '.native_update.assets[$arch] // empty' "$manifest")
  [ "$asset" = "ffdb-native-linux-$arch-$version.tar.gz" ] || die "native release asset name is invalid"
  if [ "$include_archive" = 1 ]; then
    download "$base/$asset" "$staging/$asset" || die "could not download native release archive"
    verify_checksum "$staging/SHA256SUMS" "$staging/$asset" "$asset"
  fi
  rm -rf "$destination"
  : > "$staging/.metadata-verified"
  mv "$staging" "$destination"
  trap - EXIT HUP INT TERM
  printf '%s\n' "$destination"
}

ensure_active_release_verified() {
  [ -f "$CURRENT_LINK/.signature-verified" ] && return 0
  current=$(installed_version || true)
  [ -n "$current" ] || die "installed version is unavailable"
  verified=$(fetch_verified_release "$current" 1) || die "active release verification failed"
  arch=$(host_arch)
  asset=ffdb-native-linux-$arch-$current.tar.gz
  comparison=$CACHE_ROOT/.compare-active-$$
  rm -rf "$comparison"; install -d -m 0700 "$comparison/installed" "$comparison/archive"
  safe_archive "$verified/$asset" "ffdb-native-$current"
  tar -xzf "$verified/$asset" -C "$comparison/archive" || die "could not extract active signed release"
  cp -R "$CURRENT_LINK/." "$comparison/installed/" || die "could not stage active release comparison"
  rm -f "$comparison/installed/.signature-verified" \
    "$comparison/installed/.signature-identity" "$comparison/installed/.release-url"
  diff -qr "$comparison/installed" "$comparison/archive/ffdb-native-$current" >/dev/null \
    || die "active release content does not match its signed archive"
  install -m 0644 /dev/null "$CURRENT_LINK/.signature-verified"
  printf '%s\n' "https://github.com/$OFFICIAL_REPOSITORY/.github/workflows/release.yml@refs/tags/v$current" > "$CURRENT_LINK/.signature-identity"
  printf '%s\n' "$OFFICIAL_RELEASES/tag/v$current" > "$CURRENT_LINK/.release-url"
  rm -rf "$comparison"
}

write_status() {
  available=$1
  timestamp=$(now)
  temporary=$STATUS_FILE.tmp.$$
  jq -n --arg available "$available" --arg timestamp "$timestamp" \
    '{available_version:$available,last_check_at:$timestamp,updated_at:$timestamp}' > "$temporary"
  chown root:ffdb "$temporary" 2>/dev/null || true
  chmod 0640 "$temporary"
  mv "$temporary" "$STATUS_FILE"
}

write_available_release() {
  version=$1
  manifest=$2
  schema=$(jq -r '.native_update.state_schema' "$manifest")
  minimum=$(jq -r '.native_update.minimum_rollback_version' "$manifest")
  identity=https://github.com/$OFFICIAL_REPOSITORY/.github/workflows/release.yml@refs/tags/v$version
  url=$OFFICIAL_RELEASES/tag/v$version
  temporary=$AVAILABLE_FILE.tmp.$$
  jq -n --arg version "$version" --argjson schema "$schema" --arg minimum "$minimum" \
    --arg identity "$identity" --arg url "$url" \
    '{version:$version,state_schema:$schema,minimum_rollback_version:$minimum,
      signature_verified:true,signature_identity:$identity,release_url:$url}' > "$temporary"
  chown root:ffdb "$temporary" 2>/dev/null || true; chmod 0640 "$temporary"; mv "$temporary" "$AVAILABLE_FILE"
}

within_maintenance_window() {
  settings=$1
  start=$(printf '%s' "$settings" | jq -r '.maintenance_window_start // empty')
  [ -n "$start" ] || return 1
  duration=$(printf '%s' "$settings" | jq -r '.maintenance_window_duration_minutes')
  start_hour=${start%:*}; start_minute=${start#*:}
  start_hour=$(printf '%s' "$start_hour" | sed 's/^0//'); [ -n "$start_hour" ] || start_hour=0
  start_minute=$(printf '%s' "$start_minute" | sed 's/^0//'); [ -n "$start_minute" ] || start_minute=0
  start_total=$((start_hour * 60 + start_minute))
  now_hour=$(date -u +%H); now_minute=$(date -u +%M)
  now_hour=$(printf '%s' "$now_hour" | sed 's/^0//'); [ -n "$now_hour" ] || now_hour=0
  now_minute=$(printf '%s' "$now_minute" | sed 's/^0//'); [ -n "$now_minute" ] || now_minute=0
  now_total=$((now_hour * 60 + now_minute))
  elapsed=$((now_total - start_total)); [ "$elapsed" -ge 0 ] || elapsed=$((elapsed + 1440))
  [ "$elapsed" -lt "$duration" ]
}

queue_automatic_install_if_allowed() {
  version=$1
  settings=$(read_settings)
  [ "$(printf '%s' "$settings" | jq -r '.automatic_apply')" = true ] || return 0
  within_maintenance_window "$settings" || return 0
  create_queued_job install "$version" >/dev/null
}

run_check() {
  id=$1
  job_patch "$id" running checking "Resolving the signed stable release" "" false "$(installed_version || true)"
  ensure_active_release_verified || die "active release verification failed"
  stable_tmp=$CACHE_ROOT/stable.$$
  download "$OFFICIAL_RELEASES/latest/download/stable.txt" "$stable_tmp" || die "could not resolve stable release"
  version=$(tr -d '\r\n' < "$stable_tmp"); version=${version#v}; rm -f "$stable_tmp"
  valid_version "$version" || die "stable channel returned an invalid version"
  verified=$(fetch_verified_release "$version" 0) || die "stable release verification failed"
  write_available_release "$version" "$verified/release-manifest.json"
  write_status "$version"
  current=$(installed_version || true)
  job_patch "$id" succeeded complete "Signed stable release metadata verified" "" false "$current" "$version"
  automated=$(jq -r '.automated // false' "$UPDATER_ROOT/processing-$id.json" 2>/dev/null || printf false)
  if [ "$automated" = true ] && [ -n "$current" ] && version_gt "$version" "$current"; then
    queue_automatic_install_if_allowed "$version"
  fi
}

safe_archive() {
  archive=$1
  prefix=$2
  tar -tzf "$archive" | awk -v prefix="$prefix/" '
    index($0,prefix)!=1 || $0 ~ /(^|\/)\.\.($|\/)/ || $0 ~ /^\// {bad=1}
    END {exit bad}' || die "native archive contains an unsafe path"
  tar -tvzf "$archive" | awk 'substr($1,1,1)!="-" && substr($1,1,1)!="d" {bad=1} END {exit bad}' \
    || die "native archive contains a link or special file"
}

restart_and_wait() {
  "$SYSTEMCTL" daemon-reload
  "$SYSTEMCTL" enable ffdb-api.service ffdb-sync-worker.service ffdb-gateway.service >/dev/null
  "$SYSTEMCTL" restart ffdb-api.service ffdb-sync-worker.service
  "$SYSTEMCTL" restart ffdb-gateway.service
  attempts=0
  until "$CURL" --fail --silent --show-error --max-time 5 http://127.0.0.1:8080/readyz >/dev/null 2>&1 \
    && "$CURL" --fail --silent --show-error --max-time 5 http://127.0.0.1:5173/readyz >/dev/null 2>&1; do
    attempts=$((attempts + 1)); [ "$attempts" -lt 60 ] || return 1; sleep 1
  done
}

atomic_activate() {
  target=$1
  [ -f "$target/systemd/ffdb-gateway.Caddyfile" ] || die "target release lacks gateway configuration"
  [ -f "$ENV_CONFIG" ] || die "native environment configuration is unavailable"
  s3_origin=$(awk -F= '$1 == "FFDB_S3_PUBLIC_ORIGIN" {sub(/^[^=]*=/, ""); print; exit}' "$ENV_CONFIG")
  public_origin=$(awk -F= '$1 == "FFDB_PUBLIC_BASE_URL" {sub(/^[^=]*=/, ""); print; exit}' "$ENV_CONFIG")
  printf '%s\n' "$s3_origin" | grep -Eq '^https://[A-Za-z0-9.-]+(:[0-9]+)?$' || die "configured S3 origin is invalid"
  printf '%s\n' "$public_origin" | grep -Eq '^https://[A-Za-z0-9.-]+(:[0-9]+)?$' || die "configured public origin is invalid"
  caddy_tmp=$CADDY_CONFIG.tmp.$$
  sed -e "s|https://s3.example.com|$s3_origin|g" \
    -e "s|https://ffdb.example.com|$public_origin|g" \
    "$target/systemd/ffdb-gateway.Caddyfile" > "$caddy_tmp"
  chown root:ffdb "$caddy_tmp" 2>/dev/null || true; chmod 0640 "$caddy_tmp"
  temporary=$INSTALL_ROOT/.current.$$
  ln -s "$target" "$temporary"
  if mv -Tf "$temporary" "$CURRENT_LINK" 2>/dev/null; then
    :
  elif [ "${FFDB_UPDATER_TEST_MODE:-0}" = 1 ]; then
    rm -f "$CURRENT_LINK"
    mv "$temporary" "$CURRENT_LINK"
  else
    rm -f "$temporary"
    rm -f "$caddy_tmp"
    die "atomic symlink replacement is unavailable"
  fi
  mv "$caddy_tmp" "$CADDY_CONFIG"
  printf '%s\n' "$(sed -n '1p' "$target/VERSION")" > "$STATE_ROOT/installed-version"
}

activate_with_health_or_restore() {
  target=$1
  previous=$2
  atomic_activate "$target"
  if restart_and_wait; then
    return 0
  fi
  atomic_activate "$previous"
  restart_and_wait || true
  return 1
}

check_upgrade_compatibility() {
  current=$1
  manifest=$2
  [ -f "$current/COMPATIBILITY" ] || die "active release lacks compatibility metadata"
  current_schema=$(compat_value FFDB_NATIVE_STATE_SCHEMA "$current/COMPATIBILITY")
  target_schema=$(jq -r '.native_update.state_schema' "$manifest")
  minimum=$(jq -r '.native_update.minimum_upgrade_version' "$manifest")
  [ "$current_schema" = "$target_schema" ] || die "release state schema is incompatible"
  current_version=$(sed -n '1p' "$current/VERSION")
  version_ge "$current_version" "$minimum" || die "installed version is older than the release upgrade floor"
}

run_install() {
  id=$1
  version=$2
  previous=$(installed_version || true)
  [ -n "$previous" ] || die "installed version is unavailable"
  ensure_active_release_verified || die "active release verification failed"
  stable_tmp=$CACHE_ROOT/stable-install.$$
  download "$OFFICIAL_RELEASES/latest/download/stable.txt" "$stable_tmp" || die "could not resolve stable release"
  stable=$(tr -d '\r\n' < "$stable_tmp"); stable=${stable#v}; rm -f "$stable_tmp"
  [ "$version" = "$stable" ] || die "install target is not the current stable release"
  version_gt "$version" "$previous" || die "install target must be newer than the active release"
  job_patch "$id" running verifying "Downloading and verifying the signed release" "" false "$previous" "$version" "$previous"
  verified=$(fetch_verified_release "$version" 1) || die "release verification failed"
  manifest=$verified/release-manifest.json
  check_upgrade_compatibility "$CURRENT_LINK" "$manifest"
  backup=$STATE_ROOT/backups/pre-update-$previous-to-$version-$id.tar.gz
  job_patch "$id" running backup "Creating mandatory pre-update backup" "" false "$previous" "$version" "$previous" "$backup"
  /usr/local/bin/ffdb-backup create "$backup" || die "mandatory pre-update backup failed"
  arch=$(host_arch)
  asset=ffdb-native-linux-$arch-$version.tar.gz
  extraction=$CACHE_ROOT/.extract-$id
  rm -rf "$extraction"; install -d -m 0700 "$extraction"
  safe_archive "$verified/$asset" "ffdb-native-$version"
  tar -xzf "$verified/$asset" -C "$extraction" || die "verified release extraction failed"
  bundle=$extraction/ffdb-native-$version
  [ -x "$bundle/install-native.sh" ] || die "verified archive is missing installer"
  job_patch "$id" running installing "Installing the verified release side by side" "" false "$previous" "$version" "$previous" "$backup"
  "$bundle/install-native.sh" --start --verified-release || die "verified native installer failed"
  release=$RELEASES_ROOT/$version
  if ! activate_with_health_or_restore "$release" "$RELEASES_ROOT/$previous"; then
    die "new release failed readiness checks; previous release was reactivated"
  fi
  rm -rf "$extraction"
  job_patch "$id" succeeded complete "Signed release installed and readiness verified" "" false "$version" "$version" "$previous" "$backup"
}

run_rollback() {
  id=$1
  version=$2
  previous=$(installed_version || true)
  [ -n "$previous" ] || die "installed version is unavailable"
  target=$RELEASES_ROOT/$version
  [ -d "$target" ] && [ -f "$target/.signature-verified" ] || die "rollback target is not a verified installed release"
  rollback_compatible "$target" "$CURRENT_LINK" || die "rollback target is incompatible with active state"
  backup=$STATE_ROOT/backups/pre-rollback-$previous-to-$version-$id.tar.gz
  job_patch "$id" running backup "Creating mandatory pre-rollback backup" "" false "$previous" "$previous" "$previous" "$backup"
  /usr/local/bin/ffdb-backup create "$backup" || die "mandatory pre-rollback backup failed"
  job_patch "$id" running activating "Activating the verified rollback release" "" false "$previous" "$previous" "$previous" "$backup"
  if ! activate_with_health_or_restore "$target" "$RELEASES_ROOT/$previous"; then
    die "rollback release failed readiness checks; previous release was reactivated"
  fi
  job_patch "$id" succeeded complete "Rollback activated and readiness verified" "" false "$version" "$previous" "$previous" "$backup"
}

run_configure() {
  id=$1
  encoded=$2
  payload=$(printf '%s' "$encoded" | base64 -d)
  channel=$(printf '%s' "$payload" | jq -r '.channel')
  checks=$(printf '%s' "$payload" | jq -r '.automatic_checks')
  interval=$(printf '%s' "$payload" | jq -r '.check_interval_hours')
  apply=$(printf '%s' "$payload" | jq -r '.automatic_apply')
  window=$(printf '%s' "$payload" | jq -r '.maintenance_window')
  [ "$channel" = stable ] && valid_bool "$checks" && valid_bool "$apply" || die "invalid updater settings"
  [ "$interval" -ge 1 ] && [ "$interval" -le 168 ] || die "invalid updater interval"
  start=null; duration=60
  if [ "$window" != disabled ]; then start=$(printf '%s' "$window" | cut -d/ -f1); duration=$(printf '%s' "$window" | cut -d/ -f2); fi
  temporary=$SETTINGS_FILE.tmp.$$
  jq -n --arg channel "$channel" --argjson checks "$checks" --argjson interval "$interval" \
    --argjson apply "$apply" --arg start "$start" --argjson duration "$duration" \
    '{channel:$channel,automatic_checks:$checks,check_interval_hours:$interval,automatic_apply:$apply,maintenance_window_start:(if $start=="null" then null else $start end),maintenance_window_duration_minutes:$duration}' > "$temporary"
  chown root:ffdb "$temporary" 2>/dev/null || true; chmod 0640 "$temporary"; mv "$temporary" "$SETTINGS_FILE"
  job_patch "$id" succeeded complete "Updater settings saved" "" false "$(installed_version || true)"
}

process_one() {
  request=$1
  id=$(basename "$request" .json)
  valid_uuid "$id" || { rm -f "$request"; return; }
  processing=$UPDATER_ROOT/processing-$id.json
  mv "$request" "$processing" || return
  secure_request_file "$processing" || { rm -f "$processing"; return; }
  size=$(wc -c < "$processing" | tr -d ' ')
  if [ "$size" -gt 16384 ]; then
    job_file=$JOBS_ROOT/$id.json
    if secure_job_file "$job_file"; then
      chown --no-dereference root:ffdb "$job_file" 2>/dev/null || true
      chmod 0640 "$job_file"
      job_patch "$id" failed failed "Update request exceeded 16 KiB" invalid_request false "$(installed_version || true)"
    fi
    rm -f "$processing"
    return
  fi
  operation=$(jq -r '.operation // empty' "$processing" 2>/dev/null || true)
  requested=$(jq -r '.requested_version // empty' "$processing" 2>/dev/null || true)
  [ "$(jq -r '.schema_version // 0' "$processing" 2>/dev/null || true)" = 1 ] || operation=invalid
  [ "$(jq -r '.job_id // empty' "$processing" 2>/dev/null || true)" = "$id" ] || operation=invalid
  job_file=$JOBS_ROOT/$id.json
  secure_job_file "$job_file" || { rm -f "$processing"; return; }
  chown --no-dereference root:ffdb "$job_file"; chmod 0640 "$job_file"
  active_tmp=$UPDATER_ROOT/.active-job.$$
  printf '%s\n' "$id" > "$active_tmp"; chown root:ffdb "$active_tmp" 2>/dev/null || true; chmod 0640 "$active_tmp"; mv "$active_tmp" "$UPDATER_ROOT/active-job"
  error_file=$UPDATER_ROOT/error-$id
  if (
    case "$operation" in
      check) [ -z "$requested" ] && run_check "$id" ;;
      install) valid_version "$requested" && run_install "$id" "$requested" ;;
      rollback) valid_version "$requested" && run_rollback "$id" "$requested" ;;
      configure) [ -n "$requested" ] && run_configure "$id" "$requested" ;;
      *) false ;;
    esac
  ) 2>"$error_file"; then
    :
  else
    message=$(jq -r '.message // empty' "$error_file" 2>/dev/null || true)
    [ -n "$message" ] || message=$(tail -n 1 "$error_file" | sed 's/^ffdb-update: error: //')
    [ -n "$message" ] || message="Update operation failed"
    code=internal
    retryable=false
    case "$message" in
      *signature*|*SHA-256*) code=signature_verification_failed ;;
      *backup*) code=backup_failed ;;
      *incompatible*|*compatibility*) code=incompatible_rollback ;;
      *readiness*) code=health_check_failed; retryable=true ;;
      *download*|*curl*|*network*) code=install_failed; retryable=true ;;
      *invalid*) code=invalid_request ;;
    esac
    job_patch "$id" failed failed "$message" "$code" "$retryable" "$(installed_version || true)"
  fi
  rm -f "$processing" "$error_file" "$UPDATER_ROOT/active-job"
}

process_requests() {
  require_root
  initialize
  require_command flock
  exec 9>"$LOCK_FILE"
  flock -n 9 || exit 0
  find "$JOBS_ROOT" -mindepth 1 -maxdepth 1 -type f -name '*.json' -mtime +30 -delete
  stale_jobs=$UPDATER_ROOT/stale-jobs.$$
  find "$JOBS_ROOT" -mindepth 1 -maxdepth 1 -type f -name '*.json' \
    -printf '%T@ %p\n' | sort -rn | sed -n '1001,$s/^[^ ]* //p' > "$stale_jobs"
  while IFS= read -r stale_job; do [ -z "$stale_job" ] || rm -f "$stale_job"; done < "$stale_jobs"
  rm -f "$stale_jobs"
  queue_list=$UPDATER_ROOT/queue-list.$$
  find "$REQUEST_ROOT" -mindepth 1 -maxdepth 1 -type f -name '*.json' -print | sort > "$queue_list"
  sed -n '33,$p' "$queue_list" | while IFS= read -r rejected; do
    rejected_id=$(basename "$rejected" .json)
    rejected_job=$JOBS_ROOT/$rejected_id.json
    if valid_uuid "$rejected_id" && secure_job_file "$rejected_job" \
      && [ "$(wc -c < "$rejected_job" | tr -d ' ')" -le 16384 ]; then
      chown --no-dereference root:ffdb "$rejected_job" 2>/dev/null || true; chmod 0640 "$rejected_job"
      job_patch "$rejected_id" failed failed "Updater queue capacity exceeded" busy true "$(installed_version || true)"
    fi
    rm -f "$rejected"
  done
  rm -f "$queue_list"
  while :; do
    request=$(find "$REQUEST_ROOT" -mindepth 1 -maxdepth 1 -type f -name '*.json' -print | sort | sed -n '1p')
    [ -n "$request" ] || break
    process_one "$request"
  done
}

auto_check() {
  require_root
  initialize
  settings=$(read_settings)
  [ "$(printf '%s' "$settings" | jq -r '.automatic_checks')" = true ] || exit 0
  interval=$(printf '%s' "$settings" | jq -r '.check_interval_hours')
  last=0
  [ ! -f "$UPDATER_ROOT/last-check-epoch" ] || last=$(sed -n '1p' "$UPDATER_ROOT/last-check-epoch")
  current=$(date +%s)
  [ $((current - last)) -ge $((interval * 3600)) ] || exit 0
  timestamp_tmp=$UPDATER_ROOT/.last-check-epoch.$$
  printf '%s\n' "$current" > "$timestamp_tmp"; chmod 0640 "$timestamp_tmp"; chown root:ffdb "$timestamp_tmp" 2>/dev/null || true; mv "$timestamp_tmp" "$UPDATER_ROOT/last-check-epoch"
  # Mark the request as automated so a successful check may enqueue an
  # opt-in maintenance-window installation.
  output=$(create_queued_job check)
  id=$(printf '%s' "$output" | jq -r '.job_id')
  request=$REQUEST_ROOT/$id.json
  temporary=$REQUEST_ROOT/.$id.auto.$$
  jq '.automated=true' "$request" > "$temporary"; chmod 0600 "$temporary"; mv "$temporary" "$request"
}

if [ "${FFDB_UPDATER_LIBRARY_MODE:-0}" = 1 ]; then
  return 0 2>/dev/null || exit 0
fi

command_name=${1:-}
[ -n "$command_name" ] || { usage; exit 2; }
shift || true
case "$command_name" in
  inspect) [ "$#" -eq 0 ] || die "inspect accepts no arguments"; inspect ;;
  submit) submit "$@" ;;
  job) [ "$#" -eq 1 ] || die "job requires one UUID"; job_json "$1" ;;
  initialize) [ "$#" -eq 0 ] || die "initialize accepts no arguments"; initialize ;;
  process) [ "$#" -eq 0 ] || die "process accepts no arguments"; process_requests ;;
  auto-check) [ "$#" -eq 0 ] || die "auto-check accepts no arguments"; auto_check ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "unknown command: $command_name" ;;
esac
